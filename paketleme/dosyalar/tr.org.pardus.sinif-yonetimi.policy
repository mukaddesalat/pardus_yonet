<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Pardus Sınıf Yönetimi</vendor>
  <action id="tr.org.pardus.sinif-yonetimi.kurulum-kodu">
    <description>Pardus Sınıf Yönetimi ilk kurulum kodunu okuma</description>
    <message>Pardus Sınıf Yönetimi'nin ilk kurulumunu tamamlamak için yönetici parolanızı girin.</message>
    <icon_name>pardus-sinif-yonetimi</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/pardus-sinif-yonetimi/kurulum-kodu</annotate>
  </action>
</policyconfig>
