# Pardus Sınıf Yönetimi — Ödev Teslim portalı (öğrenci erişimi)
# Laboratuvar ağına açık TEK bileşen. Ayrı ve ayrıcalıksız `pardus-odev`
# kullanıcısıyla çalışır; yalnız ödev veri dizinine yazabilir. Yönetim verisine
# (SSH anahtarı, envanter) erişemez. Port kurulumda seçilir (PSY_ODEV_PORT).

[Unit]
Description=Pardus Sınıf Yönetimi — Ödev Teslim portalı
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pardus-odev
Group=pardus-odev
EnvironmentFile=/etc/pardus-sinif-yonetimi/ortam
Environment=PSY_ODEV_DIZINI=/var/lib/pardus-sinif-odev
Environment=PSY_ODEV_ADRES=0.0.0.0
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/pardus-sinif-yonetimi
ExecStart=/opt/pardus-sinif-yonetimi/python/bin/python3 -m uygulama.odev.portal
Restart=on-failure
RestartSec=5
# Yönetim servisi (grup üyesi) ödev dosyalarını okuyabilsin
UMask=0007

# 80. portu root olmadan dinleyebilmek için yalnız bu yetki
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Sertleştirme
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/pardus-sinif-odev
InaccessiblePaths=-/var/lib/pardus-sinif-yonetimi -/etc/ssh -/root
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
